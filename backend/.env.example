# Copy to backend/.env and edit. Real environment variables always win over this file.

# development | production. Production requires SECRET_KEY and refuses insecure defaults.
ENV=development

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite by default (file: backend/resqsync.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resqsync
# DATABASE_URL=

# Where uploaded documents and request photos are stored (back this directory up with the database).
# UPLOAD_DIR=./uploads

# Load the fictional India training dataset and the demo accounts (default: on in development, off in production).
SEED_DEMO_DATA=true
# Required if SEED_DEMO_DATA=true in production. Default (development only): Resqsync#2026
# SEED_DEMO_PASSWORD=

# Show the one-click demo sign-in cards on the login page (default: on in development, off in production).
# DEMO_LOGIN=false

# Create the first administrator when the database has no users (use this instead of demo data in production).
# BOOTSTRAP_ADMIN_EMAIL=admin@your-org.example
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Let anyone create a help-seeker account from the sign-in dialog.
ALLOW_REGISTRATION=true
# Show the admin "Reset sample data" button / endpoint (default: on in development, off in production).
# ALLOW_DEMO_RESET=false

# Serve the UI from another origin only if you must (comma-separated). Same-origin needs nothing.
# CORS_ORIGINS=http://localhost:5173
# Send the session cookie over HTTPS only (default: true in production).
# COOKIE_SECURE=true
# ACCESS_TOKEN_MINUTES=720

# E-mail notifications (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ResQSync <alerts@your-org.example>
# SMTP_STARTTLS=true

# SMS notifications (msg91 or twilio)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=RESQIN
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# Web Push notifications (VAPID)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_EMAIL=mailto:admin@resqsync.org

# Outbox worker polling interval in seconds
# OUTBOX_WORKER_INTERVAL_SECONDS=3.0

