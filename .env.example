# Copy to .env and fill in strong values before running `docker compose up -d --build`.

POSTGRES_USER=postgres
# Use a URL-safe password (letters, digits, - _ . ~) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=resqsync

# 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
ENV=production

# Use a real domain (e.g. resqsync.example.org) to let Caddy provision HTTPS automatically.
# With the default ":80" plain-HTTP address, keep COOKIE_SECURE=false or login cookies will be rejected.
SITE_ADDRESS=:80
COOKIE_SECURE=false

BOOTSTRAP_ADMIN_NAME=Crisis Director
BOOTSTRAP_ADMIN_EMAIL=admin@resqsync.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Demo accounts and one-click login are development conveniences. Keep both false in production.
SEED_DEMO_DATA=false
DEMO_LOGIN=false
SEED_DEMO_PASSWORD=
ALLOW_DEMO_RESET=false
